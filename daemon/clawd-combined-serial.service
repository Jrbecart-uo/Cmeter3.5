[Unit]
Description=Clawdmeter combined daemon (Claude usage + dt42 status board -> USB screen)
After=network-online.target

[Service]
Type=simple
Environment=STATUS_URL=http://10.136.128.10:3004/status.json
# The board is found by its USB serial, never by /dev/ttyACM0 (other boards use it)
Environment=CLAWD_SERIAL=1C:DB:D4:79:7F:3C
Environment=POLL=30
ExecStart=/usr/bin/python3 %h/tmp/Clawdmeter/daemon/clawd-combined-serial.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
