{
  "port": 3004,
  "poll_interval": 45,
  "timeout": 8,
  "pushes": [
    { "url": "https://your-app.example.com/api/statusboard/ingest", "token": "REPLACE_WITH_YOUR_STATUSBOARD_TOKEN" }
  ],
  "targets": [
    { "name": "Claude API",         "short": "claude", "type": "https", "url": "https://api.anthropic.com/v1/messages",         "ok_codes": [200, 401, 405] },
    { "name": "Example site",       "short": "site",   "type": "https", "url": "https://example.com",                          "ok_below": 500 },
    { "name": "Example API",        "short": "api",    "type": "https", "url": "https://api.example.com",                      "ok_below": 600 },
    { "name": "Health endpoint",    "short": "health", "type": "https", "url": "https://app.example.com/healthz",              "ok_codes": [200] },
    { "name": "Warming-up service", "short": "reg",    "type": "https", "url": "https://registry.example.com/api/system/ping", "expect_body": "OK" },
    { "name": "Self-signed / API",  "short": "k8s",    "type": "https", "url": "https://192.0.2.10:6443/livez", "insecure": true, "ok_codes": [200, 401, 403] },
    { "name": "TCP port check",     "short": "tcp",    "type": "tcp",   "host": "example.org", "port": 443 },
    { "name": "RDP machine",        "short": "pc1",    "type": "tcp",   "host": "192.0.2.20", "port": 3389 },
    { "name": "Local web app",      "short": "web",    "type": "http",  "url": "http://localhost:3000", "ok_below": 500 },
    { "name": "Local service",      "short": "svc",    "type": "systemd_user", "unit": "my-service.service" }
  ]
}
